MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Write/destructive tools are only registered when this is exactly "true".
MS_ENABLE_WRITES=false
# Password reset and Temporary Access Pass need their own opt-in on top of MS_ENABLE_WRITES.
MS_ENABLE_PASSWORD_RESET=false
MS_ENABLE_TAP=false
# Comma-separated users (object id / UPN / mail) and groups (object id / name) that
# password reset, TAP and group-membership tools always refuse. Users holding a
# directory role and role-assignable groups are refused automatically.
# MS_PROTECTED_USERS=break-glass@contoso.com
# MS_PROTECTED_GROUPS=
# MS_ACCESS_TOKEN=
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MS_TIMEOUT_MS=30000
# MS_AUTHORITY_HOST=https://login.microsoftonline.com

# Optional Streamable HTTP hardening:
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
# MCP_ALLOWED_ORIGINS=https://your-local-client.example
# MCP_ALLOW_ANY_ORIGIN=false
# MCP_HTTP_TOKEN=
